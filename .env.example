# Railway: reference Postgres.DATABASE_URL in the service variables
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/railway
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Optional Google Ads integration (configure in Railway, do not commit credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
# Random key in hex, 32 bytes; generate locally with `openssl rand -hex 32`.
OAUTH_ENCRYPTION_KEY=
# Feature gates: defaults OFF, including in production. Only use after testing.
GOOGLE_ADS_ALLOW_ACCOUNT_CREATION=false
GOOGLE_ADS_ALLOW_CAMPAIGN_WRITES=false
GOOGLE_ADS_ALLOW_ACTIVATION=false
GOOGLE_ADS_ALLOW_LOCATION_SYNC=false
# Optional Business Profile
GOOGLE_BUSINESS_PROFILE_ENABLED=false
# Stripe integration. Start with Stripe TEST keys and test price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional assistant copy generation; NOT required for deterministic onboarding.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional operational cron token for daily snapshots; use a secret environment variable.
CRON_TOKEN=
# Only enable daily API reads after authorized Google connections.
DAILY_REPORTS_ENABLED=false
